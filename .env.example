# ============================================================
# Seed2Serve — environment configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit real credentials to version control.
# ============================================================

# HTTP server
PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=seed2serve

# Session / cookie secret (use a long random string)
SESSION_SECRET=change_me_to_a_long_random_string

# Cookie security — set to "true" when serving over HTTPS in production
COOKIE_SECURE=false

# Email delivery for the "Forgot password" flow.
# Provider: resend (default) or mailgun.
EMAIL_PROVIDER=resend
# Your provider API key (Resend: re_... / Mailgun: key-...).
EMAIL_API_KEY=
# Verified sender address, e.g. "Seed2Serve <no-reply@yourdomain.com>".
EMAIL_FROM=
# Only needed when EMAIL_PROVIDER=mailgun, e.g. mg.yourdomain.com.
MAILGUN_DOMAIN=

# Google Sign-In — optional. Create an OAuth 2.0 Client ID (Web application)
# in the Google Cloud Console, add http://localhost:3000 as an Authorized
# JavaScript origin, then paste the Client ID here:
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
